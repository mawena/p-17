// Firebase Storage Security Rules
// À configurer dans Firebase Console > Storage > Rules

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ==================== Observation Photos (SIMPLIFIÉ) ====================
    match /observations/{userId}/{observationId}/{fileName} {
      // Permettre la lecture à tous (public)
      allow read;
      
      // Permettre l'upload par le propriétaire uniquement
      allow write: if request.auth.uid == userId &&
                      request.resource.size < 10 * 1024 * 1024;
      
      // Permettre la suppression par le propriétaire
      allow delete: if request.auth.uid == userId;
    }
    
    // ==================== User Avatars ====================
    match /users/{userId}/avatar.jpg {
      allow read;
      allow write: if request.auth.uid == userId && 
                      request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth.uid == userId;
    }
    
    // ==================== Species Images ====================
    match /species/{speciesId}/image.jpg {
      allow read;
      allow write: if false;
      allow delete: if false;
    }
    
    // Par défaut: refuser tout
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
